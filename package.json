{
  "name": "legal-chatbot",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "smoke": "pnpm --filter @legal-chatbot/api e2e",
    "smoke:walk": "pnpm --filter @legal-chatbot/api e2e:walk",
    "regression": "pnpm test && pnpm --filter @legal-chatbot/api e2e",
    "db:migrate": "pnpm --filter @legal-chatbot/api db:migrate",
    "db:seed": "pnpm --filter @legal-chatbot/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
