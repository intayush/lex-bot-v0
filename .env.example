# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host.neon.tech/neondb?sslmode=require

# Google Gemini API key (used by @ai-sdk/google)
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# Session secret for dashboard auth (min 32 characters)
SESSION_SECRET=generate-with-openssl-rand-hex-32

# Widget: API URL (Vite env var, used at build time)
# VITE_API_URL=https://your-api-site.netlify.app/api/chat

# Optional: Context store URL override for seed script
# CONTEXT_STORE_URL=https://your-demo-site.netlify.app/chatbot-context/
